<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="flotale-migrator-6" author="ibrahim.al-tamimi">
        <createTable tableName="flotale_action">
            <column name="uuid" type="VARCHAR(255 ${char})">
                <constraints primaryKey="true" nullable="false"
                             primaryKeyName="pk_flotale_action"/>
            </column>
            <column name="source_task_uuid" type="VARCHAR(255 ${char})">
                <constraints nullable="false"
                             foreignKeyName="fk_action_source_task"
                             references="flotale_task(uuid)"/>
            </column>
            <column name="destination_task_uuid" type="VARCHAR(255 ${char})">
                <constraints nullable="false"
                             foreignKeyName="fk_action_dest_task"
                             references="flotale_task(uuid)"/>
            </column>
            <column name="action_key" type="VARCHAR(255 ${char})">
                <constraints nullable="false"/>
            </column>
            <column name="action_name" type="VARCHAR(255 ${char})">
                <constraints nullable="false"/>
            </column>
            <column name="action_type" type="VARCHAR(50 ${char})">
                <constraints nullable="false"/>
            </column>
            <column name="action_status" type="VARCHAR(50 ${char})">
                <constraints nullable="false"/>
            </column>
            <column name="action_message" type="VARCHAR(500 ${char})">
                <constraints nullable="true"/>
            </column>
            <column name="action_color" type="VARCHAR(50 ${char})">
                <constraints nullable="false"/>
            </column>
            <column name="action_hint" type="VARCHAR(500 ${char})">
                <constraints nullable="true"/>
            </column>
            <column name="action_outlined" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="success_execution_message" type="VARCHAR(500 ${char})">
                <constraints nullable="true"/>
            </column>
            <column name="failed_execution_message" type="VARCHAR(500 ${char})">
                <constraints nullable="true"/>
            </column>
            <column name="creation_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="flotale_action"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

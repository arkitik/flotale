<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- R15: createTable is one DDL; unique index is a separate changeset -->
    <changeSet id="flotale-migrator-7" author="ibrahim.al-tamimi">
        <createTable tableName="flotale_element">
            <column name="uuid" type="VARCHAR(255 ${char})">
                <constraints primaryKey="true" nullable="false"
                             primaryKeyName="pk_flotale_element"/>
            </column>
            <column name="element_key" type="VARCHAR(255 ${char})">
                <constraints nullable="false"/>
            </column>
            <column name="element_type" type="VARCHAR(255 ${char})">
                <constraints nullable="false"/>
            </column>
            <column name="task_uuid" type="VARCHAR(255 ${char})">
                <constraints nullable="false"
                             foreignKeyName="fk_element_task"
                             references="flotale_task(uuid)"/>
            </column>
            <column name="added_by" type="VARCHAR(255 ${char})">
                <constraints nullable="false"/>
            </column>
            <column name="creation_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="flotale_element"/>
        </rollback>
    </changeSet>

    <changeSet id="flotale-migrator-8" author="ibrahim.al-tamimi">
        <createIndex tableName="flotale_element"
                     indexName="flotale_element_unique"
                     unique="true">
            <column name="element_key"/>
            <column name="element_type"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="flotale_element" indexName="flotale_element_unique"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
